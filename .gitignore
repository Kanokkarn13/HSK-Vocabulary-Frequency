.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Virtual environments
.venv/
venv/
ENV/
env/

__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
coverage.xml
*.log

# Data files (add your exam files here — don't commit copyrighted material)
data/reading/
data/listening/
data/raw/
data/wordlist/*.csv
!data/wordlist/hsk_wordlist_EXAMPLE.csv

# Wordlist snapshot from the private flashcard app (pinyin, definitions,
# example sentences) — this is proprietary content, not ours to publish.
# The actual portfolio output (word_counts.*, unmatched_words_*, plots) is
# still tracked below — it's just word/frequency data, no app content in it.
data/processed/hsk_wordlist.csv
data/processed/hsk_wordlist.parquet
data/processed/hsk_word_level_lookup.csv
data/processed/hsk_wordlist_metadata.json
data/processed/hsk_wordlist_quarantine.csv

# Batch-local ETL staging/checkpoints and source quarantine
data/staging/
data/current/
data/raw/extraction_manifest.json

# Diagnostic output from scripts/evaluate_*.py -- regenerable, and the boundary
# dumps are large. The hand-written segmentation cases are the one input here,
# so they stay tracked and the case_* metrics reproduce from a clean checkout.
# Ignore the *contents*, not the directory: git won't re-include a file whose
# parent directory is itself excluded, so `data/validation/` would bury the
# negation below.
data/validation/*
!data/validation/segmentation_cases.csv

# Whisper model cache
~/.cache/whisper/

# Third-party reference data (downloaded on demand by notebooks, not ours to redistribute)
data/external/

# Terraform state + local variable files (contain secrets/DB passwords)
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.backup
infra/.terraform.lock.hcl
infra/*.tfvars

# Docker
*.tar

# Airflow generated files
airflow/logs/
airflow/config/airflow.cfg
airflow/config/simple_auth_manager_passwords.json
